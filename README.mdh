<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رابطة طلاب كلية الطب - جامعة السلام</title>
  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Amiri&family=Cairo:wght@500&display=swap" rel="stylesheet">
  
  <style>
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #f7fdfc;
      color: #222;
    }
    header {
      background: linear-gradient(to right, #007b83, #009688);
      color: #fff;
      padding: 20px 0;
      text-align: center;
    }
    header h1 {
      font-family: 'Amiri', serif;
      font-size: 2rem;
    }
    .navbar {
      background-color: #004d40;
    }
    .navbar .nav-link {
      color: #fff !important;
      font-weight: 500;
    }
    .hero {
      background: url('https://img.freepik.com/free-photo/medical-banner-with-stethoscope_23-2149611199.jpg') no-repeat center center/cover;
      color: white;
      padding: 100px 20px;
      text-align: center;
    }
    .hero h2 {
      font-size: 2.5rem;
      text-shadow: 2px 2px 4px #000;
    }
    .card img {
      height: 200px;
      object-fit: cover;
    }
    footer {
      background-color: #004d40;
      color: #fff;
      text-align: center;
      padding: 15px;
      margin-top: 40px;
    }
    .social-icons a {
      color: #fff;
      margin: 0 10px;
      font-size: 1.3rem;
    }
    .team img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <h1><i class="fa-solid fa-stethoscope"></i> رابطة طلاب كلية الطب – جامعة السلام</h1>
  </header>

  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand text-white" href="#">الرابطة</a>
      <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#about">عن الرابطة</a></li>
          <li class="nav-item"><a class="nav-link" href="#news">الأخبار</a></li>
          <li class="nav-item"><a class="nav-link" href="#services">الخدمات</a></li>
          <li class="nav-item"><a class="nav-link" href="#team">المكتب التنفيذي</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">تواصل معنا</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <h2>مرحباً بكم في موقع رابطة طلاب كلية الطب</h2>
    <p>نعمل لخدمة طلاب الكلية وتطوير بيئة أكاديمية واجتماعية متميزة</p>
  </section>

  <!-- About -->
  <section id="about" class="container my-5">
    <h3 class="text-center mb-4">عن الرابطة</h3>
    <p class="text-center">
      رابطة طلاب كلية الطب بجامعة السلام هي كيان طلابي يسعى إلى تمثيل الطلاب، 
      الدفاع عن حقوقهم، وتنظيم الأنشطة العلمية والاجتماعية والثقافية لتعزيز روح التعاون والانتماء.
    </p>
  </section>

  <!-- News -->
  <section id="news" class="container my-5">
    <h3 class="text-center mb-4">آخر الأخبار والأنشطة</h3>
    <div class="row">
      <div class="col-md-4">
        <div class="card">
          <img src="https://img.freepik.com/free-photo/group-medical-students_23-2148984453.jpg" class="card-img-top" alt="">
          <div class="card-body">
            <h5 class="card-title">ندوة علمية</h5>
            <p class="card-text">إقامة ندوة عن أحدث التطورات في علم الفسيولوجي.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <img src="https://img.freepik.com/free-photo/healthcare-workers-studying-together_23-2148984499.jpg" class="card-img-top" alt="">
          <div class="card-body">
            <h5 class="card-title">نشاط طلابي</h5>
            <p class="card-text">رحلة ترفيهية لتعزيز الروابط بين طلاب الكلية.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <img src="https://img.freepik.com/free-photo/doctor-speech-stage_23-2149493447.jpg" class="card-img-top" alt="">
          <div class="card-body">
            <h5 class="card-title">حملة توعوية</h5>
            <p class="card-text">حملة للتوعية بأهمية الصحة العامة في المجتمع.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="container my-5">
    <h3 class="text-center mb-4">الخدمات الطلابية</h3>
    <div class="row text-center">
      <div class="col-md-3">
        <i class="fa-solid fa-calendar-days fa-2x text-success"></i>
        <p>الجداول الدراسية</p>
      </div>
      <div class="col-md-3">
        <i class="fa-solid fa-graduation-cap fa-2x text-primary"></i>
        <p>نتائج الامتحانات</p>
      </div>
      <div class="col-md-3">
        <i class="fa-solid fa-user-doctor fa-2x text-danger"></i>
        <p>استشارات أكاديمية</p>
      </div>
      <div class="col-md-3">
        <i class="fa-solid fa-people-group fa-2x text-warning"></i>
        <p>الدعم الطلابي</p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="container my-5 text-center">
    <h3 class="mb-4">المكتب التنفيذي</h3>
    <div class="row g-4">
      <div class="col-md-3"><h5>محمد آدم أحمد إسحاق</h5><p>رئيس الرابطة</p></div>
      <div class="col-md-3"><h5>مصطفى إسحاق إدريس</h5><p>نائب الرئيس</p></div>
      <div class="col-md-3"><h5>حسام محمد</h5><p>الأمين العام</p></div>
      <div class="col-md-3"><h5>أمجد أيمن</h5><p>الأمين المالي</p></div>
      <div class="col-md-3"><h5>معتصم محمد الأمين</h5><p>نائباً</p></div>
      <div class="col-md-3"><h5>مجتبى جلال</h5><p>الأمين الرياضي</p></div>
      <div class="col-md-3"><h5>محمد أحمد التوم</h5><p>نائباً</p></div>
      <div class="col-md-3"><h5>سبأ عبدالله</h5><p>أمين التثقيف الصحي</p></div>
      <div class="col-md-3"><h5>محمد صديق</h5><p>نائباً</p></div>
      <div class="col-md-3"><h5>محمد الشفيع قادم</h5><p>أمين العلاقات الخارجية</p></div>
      <div class="col-md-3"><h5>إسراء إبراهيم</h5><p>نائباً</p></div>
      <div class="col-md-3"><h5>الصادق الهادي إبراهيم</h5><p>الأمين الأكاديمي</p></div>
      <div class="col-md-3"><h5>أكرم إبراهيم رحمة</h5><p>أمين الإعلام</p></div>
      <div class="col-md-3"><h5>مزدلفة أحمد</h5><p>نائب أمين الإعلام</p></div>
      <div class="col-md-3"><h5>إسراء عبدالله</h5><p>أمين شؤون العضوية</p></div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="container my-5">
    <h3 class="text-center mb-4">تواصل معنا</h3>
    <form class="row g-3">
      <div class="col-md-6">
        <input type="text" class="form-control" placeholder="الاسم">
      </div>
      <div class="col-md-6">
        <input type="email" class="form-control" placeholder="البريد الإلكتروني">
      </div>
      <div class="col-12">
        <textarea class="form-control" rows="4" placeholder="رسالتك"></textarea>
      </div>
      <div class="col-12 text-center">
        <button type="submit" class="btn btn-success">إرسال</button>
      </div>
    </form>
    <div class="text-center social-icons mt-4">
      <a href="#"><i class="fab fa-facebook"></i></a>
      <a href="#"><i class="fab fa-twitter"></i></a>
      <a href="#"><i class="fab fa-whatsapp"></i></a>
      <a href="#"><i class="fab fa-telegram"></i></a>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2025 رابطة طلاب كلية الطب – جامعة السلام. جميع الحقوق محفوظة.</p>
  </footer>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

